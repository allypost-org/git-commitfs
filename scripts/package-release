#!/usr/bin/env bash
# Package the release binary for the selected target into dist/.
#
# The archive name and layout must match [package.metadata.binstall] in
# Cargo.toml, which cargo-binstall (and mise's github backend, by platform
# keywords in the file name) rely on to find the download.
#
# Usage: scripts/package-release [target-triple]
# The target defaults to CARGO_BUILD_TARGET (set by mise) and the binary must
# already be built with `just build`. When RELEASE_TAG is set (CI), it must
# equal v<Cargo.toml version>.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

target=${1:-${CARGO_BUILD_TARGET:-}}
if [[ -z "$target" ]]; then
    echo 'No target: pass one or set CARGO_BUILD_TARGET' >&2
    exit 2
fi

version=$(cargo pkgid --locked | sed 's/.*[#@]//')
if [[ -n "${RELEASE_TAG:-}" && "$RELEASE_TAG" != "v$version" ]]; then
    echo "Tag $RELEASE_TAG does not match Cargo.toml version $version" >&2
    exit 1
fi

binary=$(cargo metadata --locked --no-deps --format-version 1 |
    python3 -I -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')/$target/release/git-commitfs
if [[ ! -x "$binary" ]]; then
    echo "Missing $binary; run 'just build' for $target first" >&2
    exit 1
fi

name=git-commitfs-$target-v$version
rm -rf "dist/$name" "dist/$name.tar.gz" "dist/$name.tar.gz.sha256"
mkdir -p "dist/$name"
cp "$binary" README.md "dist/$name/"
for extra in LICENSE LICENSE-MIT LICENSE-APACHE; do
    if [[ -f "$extra" ]]; then
        cp "$extra" "dist/$name/"
    fi
done

# Keep macOS tar from adding AppleDouble (._*) entries.
COPYFILE_DISABLE=1 tar -C dist -czf "dist/$name.tar.gz" "$name"
rm -rf "dist/$name"

(
    cd dist
    if command -v sha256sum >/dev/null; then
        sha256sum "$name.tar.gz"
    else
        shasum -a 256 "$name.tar.gz"
    fi >"$name.tar.gz.sha256"
)
echo "dist/$name.tar.gz"
