#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
    printf '%s\n' 'usage: scripts/check-staged-tree' >&2
    exit 2
fi

root=$(git rev-parse --show-toplevel)
cd "$root"
run=$(mktemp -d "${TMPDIR:-/tmp}/git-commitfs-hook.XXXXXXXX")
trap 'rm -rf -- "$run"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

git diff --cached --name-only --no-renames --diff-filter=ACMRDT -z >"$run/changed"
needs_cargo=false
while IFS= read -r -d '' path; do
    case "$path" in
        *.rs|Cargo.toml|*/Cargo.toml|Cargo.lock|*/Cargo.lock|.cargo/*|rust-toolchain*|rustfmt.toml|rustfmt-stable.toml|.rustfmt.toml|mise.toml|mise.lock|justfile|hk.pkl|tombi.toml|.gitignore|*/.gitignore|.ignore|*/.ignore|.fdignore|*/.fdignore|scripts/*)
            needs_cargo=true
            break
            ;;
    esac
done <"$run/changed"
"$needs_cargo" || exit 0

index=$(git rev-parse --path-format=absolute --git-path index)
objects=$(git rev-parse --path-format=absolute --git-path objects)
object_format=$(git rev-parse --show-object-format)
git rev-parse --local-env-vars >"$run/git-env"
cp -- "$index" "$run/index"
mkdir -p "$run/objects/info"
printf '%s\n' "$objects" >"$run/objects/info/alternates"

# Keep write-tree's cache and new tree objects out of the source index/store.
tree=$(GIT_INDEX_FILE="$run/index" GIT_OBJECT_DIRECTORY="$run/objects" git -c core.splitIndex=false write-tree)

while IFS= read -r name; do
    unset "$name"
done <"$run/git-env"

snapshot="$run/worktree"
git init --quiet --template= --object-format="$object_format" "$snapshot"
cd "$snapshot"
git config core.hooksPath "$run/no-hooks"
printf '%s\n' "$run/objects" >.git/objects/info/alternates
git read-tree "$tree"
GIT_ATTR_SOURCE="$tree" git checkout-index --all --ignore-skip-worktree-bits
commit=$(
    GIT_AUTHOR_NAME=git-commitfs GIT_AUTHOR_EMAIL=git-commitfs@localhost \
    GIT_COMMITTER_NAME=git-commitfs GIT_COMMITTER_EMAIL=git-commitfs@localhost \
        git commit-tree "$tree" -m 'Staged hook snapshot'
)
git update-ref HEAD "$commit"

# Build output is a dedicated ignored cache; source/config edits stay disposable.
export CARGO_TARGET_DIR="$root/target/hk"
printf '%s\n' '==> staged Cargo.lock, Clippy, Rust/Cargo format checks, and tests'
mise exec -- just check
printf '%s\n' '==> fmt-dev must not change the staged checkout'
# Fixing must not overwrite artifacts a cache wrapper restored as read-only.
CARGO_TARGET_DIR="$run/fix-target" mise exec -- just fmt-dev
if ! git diff --exit-code --; then
    printf '%s\n' 'just fmt-dev changes staged files; run it in the checkout and stage the result.' >&2
    exit 1
fi
git ls-files --others --exclude-standard -z >"$run/untracked"
if [[ -s "$run/untracked" ]]; then
    printf '%s\n' 'just fmt-dev created untracked files in the staged checkout.' >&2
    exit 1
fi
