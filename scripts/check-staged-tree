#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
    printf '%s\n' 'usage: scripts/check-staged-tree' >&2
    exit 2
fi

# A sentinel preserves trailing newlines in the repository path.
root=$(git rev-parse --show-toplevel && printf '.')
root=${root%$'\n.'}

# Preserve the caller's cwd for relative Git routing; match paths from the root.
changed=0
git diff --cached --exit-code --name-only --no-renames --no-ext-diff --no-textconv -- \
    ':(top,glob)**/*.rs' ':(top,glob)**/Cargo.toml' ':(top,glob)**/Cargo.lock' \
    ':(top,glob).cargo/**' ':(top,glob)rust-toolchain*' ':(top)rustfmt.toml' ':(top)rustfmt-stable.toml' \
    ':(top).rustfmt.toml' ':(top)mise.toml' ':(top)mise.lock' ':(top)justfile' ':(top)hk.pkl' ':(top)tombi.toml' \
    ':(top,glob)**/.gitignore' ':(top,glob)**/.ignore' ':(top,glob)**/.fdignore' \
    ':(top,glob)scripts/**' >/dev/null || changed=$?
case "$changed" in
    0) exit 0 ;;
    1) ;;
    *) exit "$changed" ;;
esac

binary=$(type -P git-commitfs || true)
# A mise shim can exist even when its underlying CLI is no longer installed.
if [[ -n "$binary" ]] && "$binary" --version >/dev/null 2>&1; then
    binary=$(realpath -s -- "$binary")
else
    bootstrap="$root/target/hk-bootstrap"
    printf '%s\n' '==> building git-commitfs for the staged hook' >&2
    mise exec -- cargo build --locked --bin git-commitfs \
        --target x86_64-unknown-linux-musl --target-dir "$bootstrap"
    binary="$bootstrap/x86_64-unknown-linux-musl/debug/git-commitfs"
fi

# Keep the effective Git index environment intact until the app captures it.
exec "$binary" run -- bash scripts/check-hook-workspace "$root/target/hk"
